# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Do NOT commit real organization names, project names, area paths, or PATs.

# --- Azure DevOps source ---
# Organization name only (not the full https://dev.azure.com/... URL).
DORA_ORG=my-org
# Project name (may contain spaces).
DORA_PROJECT=My Project
# Window start, YYYY-MM-DD. Leave empty to default to Oct 1 of last year.
DORA_SINCE=2025-01-01
# Trunk branch used for lead time + deployment counting. Comma-separated to treat
# several branches as trunk (e.g. main,master).
DORA_TARGET_BRANCH=main
# Environment name to headline (deploy freq / CFR / MTTR). Use your most
# prod-like env if you have no prod yet (e.g. qa).
DORA_PROD_ENV=prod
# Optional: area path scoping the Reliability (ADO-bug) metric. Bugs are matched
# with "AreaPath UNDER <this>", so set it to your PROJECT NAME to pull ALL bugs
# (e.g. "My Project"), or a sub-area to narrow it. The dashboard splits bugs by
# area regardless. Leave empty to skip reliability. Escape backslashes in
# sub-areas: "My Project\\Some Area".
DORA_RELIABILITY_AREA_PATH=

# --- Azure DevOps auth ---
# Personal Access Token with Code (read), Build (read), Work Items (read) scopes.
ADO_PAT=replace-with-your-pat

# --- Refresh cadence ---
# Seconds between exporter runs. 3600 = hourly.
REFRESH_INTERVAL_SECONDS=3600

# --- Postgres ---
POSTGRES_USER=dora
POSTGRES_PASSWORD=dora
POSTGRES_DB=dora

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
